@page
@model IndexDragonBall

@if (Model.DragonBalls?.Count > 0)
{

<div style="display: flex; flex-wrap: wrap;">
        @foreach (var dragonball in Model.DragonBalls)
        {
            <div style="border: 1px solid #ccc; margin: 10px; padding: 10px; width: 200px;">
                <img src="@dragonball.ImageUrl" alt="ID @dragonball.Id" width="100" />
                <p><strong>@dragonball.Id</strong></p>
                <p>Nome: @dragonball.Name</p>
                <a asp-page="/Infodragonball" asp-route-id="@dragonball.Id">Ver Info</a>
            </div>
        }
    </div>
}
else
{
    <p>ERRO : não temos lista </p>
}